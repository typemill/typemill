	<section id="landingpageteaser" class="landingpageteaser w-100 dib tc bl br bb">
		
		<div class="mw8 pv6 ph3 center flex-m flex-l justify-around">
			{% if theme.teaser1title %}
				<div class="mw5 center ml0-l mr0-l mv4 flex flex-column flex-grow">
					<h2 class="f2">{{ theme.teaser1title|e }}</h2>
					<p class="f5 f4-ns fw3 mt0 lh-copy flex-grow">{{ theme.teaser1text|e }}</p>
					<a href="{{ theme.teaser1link }}" class="button link dim w-100 dib pa3 ma1 ba">{{ theme.teaser1label|e }}</a>
				</div>
			{% endif %}
			{% if theme.teaser2title %}
				<div class="mw5 center ml0-l mr0-l mv4 flex flex-column flex-grow">
