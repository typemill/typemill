{% extends 'layouts/layoutAuth.twig' %}

{% block title %}{{ translate('Password Recovery Confirmation') }}{% endblock %}

{% block content %}

	<div class="lg:flex-row flex flex-col-reverse min-h-screen lg:min-h-0 justify-end">
		
		<div class="lg:w-1/2 flex-1 lg:flex-none lg:min-h-screen flex justify-center items-center" style="background-color: {{ authpagebgcolor|default('#0d9488') }}; color: {{ authpagetextcolor|default('#ffffff') }};">
			<div class="max-w-md content-center">
			
				<div class="my-2">
					<p>{{ translate('Done') }}! </p>
				</div>
				
			</div>
		</div>
		
		<div class="lg:w-1/2 p-5 border-b border-white content-center flex justify-center items-center auth-right-side">

			<div class="max-w-md content-center">
				<h1 class="text-4xl py-5">{{ title|e }}</h1>
				<p>{{ message|e }}</p>
				<p><a 		href="{{ url_for("auth.login") }}"
						class="block w-full mt-6 px-3 py-3 font-medium text-center text-xs leading-tight uppercase bg-teal-600 text-white pointer hover:bg-teal-700 cursor-pointer focus:outline-none focus:ring-0 transition duration-100 ease-in-out"
						>{{ translate('go to login') }}</a></p>
			</div>
		
		</div>
	
	</div>
{% endblock %}
