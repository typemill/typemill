{% extends 'layouts/layoutAuth.twig' %}

{% block title %}{{ translate('Password Recovery Confirmation') }}{% endblock %}

{% block content %}

	<div class="flex flex-col-reverse min-h-screen justify-end {{ authpagestacked ? '' : 'lg:flex-row lg:min-h-0' }}">
		
		<div class="flex-1 flex justify-center items-center {{ authpagestacked ? 'w-full' : 'lg:w-1/2 lg:flex-none lg:min-h-screen' }}" style="background-color: {{ authpagebgcolor|default('#0d9488') }}; color: {{ authpagetextcolor|default('#ffffff') }};">
			<div class="max-w-md content-center">
			
				<div class="my-2">
					<p>{{ translate('Done') }}! </p>
				</div>
				
			</div>
		</div>
		
		<div class="p-5 border-b border-white content-center flex justify-center items-center auth-right-side {{ authpagestacked ? 'w-full' : 'lg:w-1/2' }}">

			<div class="max-w-md content-center {{ authpagestacked ? 'text-center' : '' }}">
				<h1 class="text-4xl py-5">{{ title|e }}</h1>
				<p>{{ message|e }}</p>
				<p><a 		href="{{ url_for("auth.login") }}"
						class="block mt-6 px-3 py-3 font-medium text-center text-xs leading-tight uppercase"
						>{{ translate('go to login') }}</a></p>
			</div>
		
		</div>
	
	</div>
{% endblock %}
