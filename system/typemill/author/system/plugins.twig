{% extends 'layouts/layoutSystem.twig' %}
{% block title %}{{ translate('Plugin Settings') }}{% endblock %}

{% block content %}

	<div class="flex justify-between">	
		<h1 class="flex items-center text-3xl font-bold">{{ translate('Plugins') }}
			{% if jsdata.aiconfigured %}
				<span class="pl-4 text-lg">
					<a href="javascript:void(0)" onclick="eventBus.$emit('startHelp')" class="text-stone-400 hover:text-teal-600 transition duration-100">
						<svg class="icon icon-question"><use xlink:href="#icon-question"></use></svg>
					</a>
				</span>	
			{% endif %}
		</h1>
		<div class="text-center">
			<a href="https://plugins.typemill.net" target="_blank" class="p-3 border border-teal-500 hover:bg-teal-500 hover:text-white transition duration-100">{{ translate('Visit the Plugin Directory') }}</a>
		</div>
	</div>

	<div id="plugins" v-cloak></div>

{% endblock %}

{% block javascript %}

	<script src="{{ base_url() }}/system/typemill/author/js/highlight.min.js?v={{ settings.version }}"></script>
	<script src="{{ base_url() }}/system/typemill/author/js/vue-plugins.js?v={{ settings.version }}"></script>
	<script src="{{ base_url() }}/system/typemill/author/js/vue-forms.js?v={{ settings.version }}"></script>

	<script>
		app.config.globalProperties.$filters = translatefilter;
		app.mount('#plugins');
	</script>

{% endblock %}
