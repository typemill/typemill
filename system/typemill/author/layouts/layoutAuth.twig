<!DOCTYPE html>
<html lang="en" class="{{ settings.darkmode ? 'dark' :'darkmodeoff' }}" >
	<head>
		<meta charset="UTF-8">
		<title>{% block title %}{% endblock %}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<meta name="description" content="Welcome to your new TYPEMILL website" />
		<meta name="robots" content="noindex" />
		
		<meta name="msapplication-TileColor" content="#F9F8F6" />
		<meta name="msapplication-TileImage" content="{{ base_url() }}/system/author/img/favicon-144.png" />
		<link rel="icon" type="image/png" href="{{ base_url() }}/system/author/img/favicon-16.png" sizes="16x16" />
		<link rel="icon" type="image/png" href="{{ base_url() }}/system/author/img/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" sizes="72x72" href="{{ base_url() }}/system/author/img/favicon-72.png" />
		<link rel="apple-touch-icon" sizes="114x114" href="{{ base_url() }}/system/author/img/favicon-114.png" />
		<link rel="apple-touch-icon" sizes="144x144" href="{{ base_url() }}/system/author/img/favicon-144.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="{{ base_url() }}/system/author/img/favicon-180.png" />

		<link rel="stylesheet" href="{{ base_url() }}/system/typemill/author/css/output.css?v={{ settings.version }}" />

		{{ assets.renderCSS() }}

		<style>
			.auth-right-side {
				background-color: {{ authpagebgcolor|default('#0d9488') }};
				color: {{ authpagetextcolor|default('#ffffff') }};
			}
			@media (min-width: 1024px) {
				.auth-right-side {
					background-color: {{ authpagerightbg|default('#ffffff') }};
					color: {{ authpagerighttextcolor|default('#000000') }};
				}
			}
			.auth-btn:hover {
				background-color: rgba(0,0,0,0.15);
			}
			.auth-right-side h1,
			.auth-right-side h2,
			.auth-right-side h3,
			.auth-right-side h4,
			.auth-right-side h5,
			.auth-right-side h6 {
				margin-top: 1.5em;
				margin-bottom: 0.5em;
				font-weight: 700;
				line-height: 1.2;
			}
			.auth-right-side h1:first-child,
			.auth-right-side h2:first-child,
			.auth-right-side h3:first-child,
			.auth-right-side h4:first-child,
			.auth-right-side h5:first-child,
			.auth-right-side h6:first-child {
				margin-top: 0;
			}
			.auth-right-side h1 { font-size: 2.25em; }
			.auth-right-side h2 { font-size: 1.75em; }
			.auth-right-side h3 { font-size: 1.5em; }
			.auth-right-side h4 { font-size: 1.25em; }
			.auth-right-side h5 { font-size: 1.1em; }
			.auth-right-side h6 { font-size: 1em; }
			.auth-right-side p {
				margin-bottom: 1em;
				line-height: 1.6;
			}
			.auth-right-side a {
				color: inherit;
				text-decoration: underline;
			}
			.auth-right-side ul,
			.auth-right-side ol {
				margin-bottom: 1em;
				padding-left: 1.5em;
			}
			.auth-right-side ul {
				list-style-type: disc;
			}
			.auth-right-side ol {
				list-style-type: decimal;
			}
			.auth-right-side li {
				margin-bottom: 0.25em;
				line-height: 1.5;
			}
			.auth-right-side img {
				max-width: 100%;
				height: auto;
				display: block;
				margin: 1em 0;
			}
			.auth-right-side blockquote {
				margin: 1em 0;
				padding-left: 1em;
				border-left: 3px solid currentColor;
				opacity: 0.85;
			}
			.auth-right-side code {
				background-color: rgba(0,0,0,0.08);
				padding: 0.2em 0.4em;
				border-radius: 3px;
				font-family: monospace;
				font-size: 0.9em;
			}
			.auth-right-side pre {
				background-color: rgba(0,0,0,0.08);
				padding: 1em;
				border-radius: 4px;
				overflow-x: auto;
				margin-bottom: 1em;
			}
			.auth-right-side pre code {
				background: none;
				padding: 0;
				font-size: 0.9em;
			}
			.auth-right-side table {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 1em;
			}
			.auth-right-side th,
			.auth-right-side td {
				border: 1px solid rgba(0,0,0,0.2);
				padding: 0.5em;
				text-align: left;
			}
			.auth-right-side hr {
				margin: 1.5em 0;
				border: none;
				border-top: 1px solid rgba(0,0,0,0.2);
			}
		</style>
		
	</head>
	<body class="text-base">
		<svg style="position: absolute; width: 0; height: 0; overflow: hidden" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
			<defs>
				<symbol id="icon-bookmark-o" viewBox="0 0 20 28">
					<title>bookmark-o</title>
					<path d="M18 4h-16v19.406l8-7.672 1.391 1.328 6.609 6.344v-19.406zM18.188 2c0.234 0 0.469 0.047 0.688 0.141 0.688 0.266 1.125 0.906 1.125 1.609v20.141c0 0.703-0.438 1.344-1.125 1.609-0.219 0.094-0.453 0.125-0.688 0.125-0.484 0-0.938-0.172-1.297-0.5l-6.891-6.625-6.891 6.625c-0.359 0.328-0.812 0.516-1.297 0.516-0.234 0-0.469-0.047-0.688-0.141-0.688-0.266-1.125-0.906-1.125-1.609v-20.141c0-0.703 0.438-1.344 1.125-1.609 0.219-0.094 0.453-0.141 0.688-0.141h16.375z"></path>
				</symbol>
			</defs>
		</svg>

		{% include 'partials/flash.twig' %}

		<div>

			{% block content %}{% endblock %}

		</div>
	</body>
</html>